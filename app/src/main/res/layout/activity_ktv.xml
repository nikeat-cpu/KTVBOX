<?xml version="1.0" encoding="utf-8"?>
<!-- KTV 点歌台主界面 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="@dimen/vs_40"
    android:paddingTop="@dimen/vs_20"
    android:paddingRight="@dimen/vs_40"
    android:paddingBottom="@dimen/vs_20">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_60"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="@dimen/vs_5"
            android:layout_height="@dimen/vs_40"
            android:layout_marginEnd="@dimen/vs_12"
            android:layout_marginRight="@dimen/vs_12"
            android:background="@drawable/shape_ktv_bar" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ktv_title"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_34"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvQueueCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vs_15"
            android:layout_marginLeft="@dimen/vs_15"
            android:textColor="#B3FFFFFF"
            android:textSize="@dimen/ts_20" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvClearQueue"
            android:layout_width="@dimen/vs_120"
            android:layout_height="@dimen/vs_50"
            android:background="@drawable/shape_ktv_focus"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/ktv_clear"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_20" />
    </LinearLayout>

    <!-- 主体 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/vs_15"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 左：点歌搜索 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_50"
                android:orientation="horizontal">

                <com.github.tvbox.osc.ui.tv.widget.CustomEditText
                    android:id="@+id/edtSearch"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/vs_50"
                    android:layout_marginEnd="@dimen/vs_10"
                    android:layout_marginRight="@dimen/vs_10"
                    android:layout_weight="1"
                    android:background="@drawable/shape_ktv_input"
                    android:hint="@string/ktv_search_hint"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingLeft="@dimen/vs_10"
                    android:paddingRight="@dimen/vs_10"
                    android:singleLine="true"
                    android:textColor="@android:color/white"
                    android:textColorHint="#70FFFFFF"
                    android:textSize="@dimen/ts_20" />

                <TextView
                    android:id="@+id/btnSearch"
                    android:layout_width="@dimen/vs_150"
                    android:layout_height="@dimen/vs_50"
                    android:background="@drawable/shape_ktv_focus"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/ktv_search"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_20" />
            </LinearLayout>

            <!-- 热门快捷点歌 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_50"
                android:layout_marginTop="@dimen/vs_10"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvHot1"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/vs_50"
                    android:layout_marginEnd="@dimen/vs_10"
                    android:layout_marginRight="@dimen/vs_10"
                    android:layout_weight="1"
                    android:background="@drawable/shape_ktv_focus"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/ktv_hot_1"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_20" />

                <TextView
                    android:id="@+id/tvHot2"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/vs_50"
                    android:layout_marginEnd="@dimen/vs_10"
                    android:layout_marginRight="@dimen/vs_10"
                    android:layout_weight="1"
                    android:background="@drawable/shape_ktv_focus"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/ktv_hot_2"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_20" />

                <TextView
                    android:id="@+id/tvHot3"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/vs_50"
                    android:layout_marginEnd="@dimen/vs_10"
                    android:layout_marginRight="@dimen/vs_10"
                    android:layout_weight="1"
                    android:background="@drawable/shape_ktv_focus"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/ktv_hot_3"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_20" />

                <TextView
                    android:id="@+id/tvHot4"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/vs_50"
                    android:layout_weight="1"
                    android:background="@drawable/shape_ktv_focus"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/ktv_hot_4"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_20" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSearchTip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_10"
                android:text="@string/ktv_tip_default"
                android:textColor="#B3FFFFFF"
                android:textSize="@dimen/ts_20" />

            <!-- 搜索结果翻页 -->
            <LinearLayout
                android:id="@+id/layoutPager"
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_50"
                android:layout_marginTop="@dimen/vs_10"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btnPrevPage"
                    android:layout_width="@dimen/vs_150"
                    android:layout_height="@dimen/vs_50"
                    android:background="@drawable/shape_ktv_focus"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/ktv_prev_page"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_20" />

                <TextView
                    android:id="@+id/tvPageInfo"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/vs_50"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="#B3FFFFFF"
                    android:textSize="@dimen/ts_20" />

                <TextView
                    android:id="@+id/btnNextPage"
                    android:layout_width="@dimen/vs_150"
                    android:layout_height="@dimen/vs_50"
                    android:background="@drawable/shape_ktv_focus"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/ktv_next_page"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_20" />
            </LinearLayout>

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/rvResult"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/vs_10"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingTop="@dimen/vs_10"
                android:paddingBottom="@dimen/vs_10"
                app:tv_horizontalSpacingWithMargins="@dimen/vs_20"
                app:tv_selectedItemIsCentered="true"
                app:tv_verticalSpacingWithMargins="@dimen/vs_20" />
        </LinearLayout>

        <!-- 右：已点歌曲队列 -->
        <LinearLayout
            android:layout_width="@dimen/vs_420"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/vs_20"
            android:background="@drawable/shape_thumb_radius"
            android:orientation="vertical"
            android:padding="@dimen/vs_15">

            <TextView
                android:id="@+id/tvQueueTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ktv_queue_title"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_24"
                android:textStyle="bold" />

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/rvQueue"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/vs_10"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:tv_horizontalSpacingWithMargins="@dimen/vs_10"
                app:tv_verticalSpacingWithMargins="@dimen/vs_10" />

            <TextView
                android:id="@+id/tvQueueEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/ktv_queue_empty"
                android:textColor="#80FFFFFF"
                android:textSize="@dimen/ts_20" />

            <!-- 已播列表（唱完的歌） -->
            <LinearLayout
                android:id="@+id/layoutPlayed"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/vs_10"
                android:layout_weight="1"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/vs_2"
                    android:layout_marginBottom="@dimen/vs_10"
                    android:background="#334DD0E1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPlayedTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ktv_played_title"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/ts_24"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvClearPlayed"
                        android:layout_width="@dimen/vs_120"
                        android:layout_height="@dimen/vs_50"
                        android:background="@drawable/shape_ktv_focus"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/ktv_clear_played"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/ts_20" />
                </LinearLayout>

                <com.owen.tvrecyclerview.widget.TvRecyclerView
                    android:id="@+id/rvPlayed"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/vs_10"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    app:tv_horizontalSpacingWithMargins="@dimen/vs_10"
                    app:tv_verticalSpacingWithMargins="@dimen/vs_10" />

                <TextView
                    android:id="@+id/tvPlayedEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/ktv_played_empty"
                    android:textColor="#80FFFFFF"
                    android:textSize="@dimen/ts_20" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
